# Netlify response headers: https://docs.netlify.com/routing/headers/
# Copied to _site by the `include` setting in _config.yml.
#
# HTML, CSS and JS keep Netlify's default (always revalidate) so a deploy is
# picked up immediately. Only files that never change under the same URL are
# cached long term.

# Responsive images generated by jekyll_picture_tag: the file name contains a
# hash of the source image and settings, so a changed image gets a new URL.
/generated/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts. If a font file is ever replaced, rename it.
/libs/external/fonts/Graphik-Regular.woff2
  Cache-Control: public, max-age=31536000, immutable
/libs/external/fonts/Graphik-Semibold.woff2
  Cache-Control: public, max-age=31536000, immutable
/libs/external/fonts/Tiempos-Headline-Semibold.woff2
  Cache-Control: public, max-age=31536000, immutable

# Icon font (the directory name is the fontello build id)
/libs/external/fontello-bb2d1770/font/*
  Cache-Control: public, max-age=31536000, immutable

# Original post images and diagrams (opened in the lightbox). Not fingerprinted,
# so cache for a day only: a replaced image shows up within 24h.
/assets/*
  Cache-Control: public, max-age=86400
